{
  "name": "dsh-advisor-flow",
  "version": "0.2.1",
  "type": "module",
  "description": "DeepSeek Harness plugin porting pi-advisor-flow: an on-demand executor/advisor workflow with consultation tool, review gates, usage ledger, privacy tiers and secret redaction.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "advisor",
    "second-opinion",
    "review-gates",
    "consultation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ccll/dsh-advisor-flow.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "build:client": "node scripts/build-client.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compat": {
      "dsh": "0.1.5-rc.1",
      "seams": [
        "tools/pre-execute",
        "tools/result",
        "session/event",
        "systemPrompt.section",
        "agent.steer",
        "tools.register(output)",
        "settings.installSection",
        "GatewayService RPC",
        "commands.register"
      ]
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-api-gateway": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-client-connection": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-client-store": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-commands": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-timeout": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-typert-registry": "^0.1.5-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.5-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "esbuild": "^0.28.2",
    "playwright": "1.62.1"
  }
}
